# --- Required for live Finnhub news ingestion ---
NEWS_SOURCE=finnhub
NEWS_API_KEY=your_finnhub_api_key_here   # free tier at finnhub.io/register
NEWS_API_URL=https://finnhub.io/api/v1

# --- Required for production security ---
SECRET_KEY=generate_a_random_64_char_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set_a_strong_password

# --- Render injects these automatically via render.yaml ---
DATABASE_URL=postgresql+asyncpg://...
REDIS_URL=redis://...

# --- Set to the Render frontend service URL once deployed ---
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.onrender.com"]

# --- Keep paper trading on until you verify the pipeline is working ---
PAPER_TRADING_MODE=true
PAPER_AUTO_APPROVE=true
PRICE_SOURCE=mock
ALLOW_MOCK_PRICE_FALLBACK=true

# --- Regime-aware lead engine ---
MAX_DAILY_LEADS=5
CLUSTER_WINDOW_HOURS=6
MIN_EV_USD=0.0
CAUTION_THEME_MIN_CONFIDENCE=0.62
EDGE_MIN_SAMPLES=20
EDGE_SHRINKAGE_WEIGHT=0.5
AUGUST_SEASONALITY_ENABLED=true
DEFAULT_RANGE_ROTATION=true
